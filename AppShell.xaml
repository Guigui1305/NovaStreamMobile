<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="NovaStreamMobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NovaStreamMobile.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       BackgroundColor="{StaticResource Secondary}"
       ForegroundColor="White"
       Title="NovaStream">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Secondary}" />
            <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="Gray" />
            <Setter Property="Shell.TabBarTitleColor" Value="White" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate views:HomeView}" />
        </Tab>
        <Tab Title="Live TV">
            <ShellContent ContentTemplate="{DataTemplate views:LiveTvView}" />
        </Tab>
        <Tab Title="Sources">
            <ShellContent ContentTemplate="{DataTemplate views:SourcesView}" />
        </Tab>
        <Tab Title="Settings">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" />
        </Tab>
    </TabBar>

</Shell>
