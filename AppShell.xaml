<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="NovaStreamMobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NovaStreamMobile.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="#0D0D1A"
       Shell.TabBarForegroundColor="#E50914"
       Shell.TabBarUnselectedColor="#606080"
       Shell.TabBarTitleColor="#E50914"
       BackgroundColor="#08081A"
       ForegroundColor="White">

    <TabBar>
        <Tab Title="Studio">
            <ShellContent ContentTemplate="{DataTemplate views:GeneratorView}" />
        </Tab>
        <Tab Title="Accueil">
            <ShellContent ContentTemplate="{DataTemplate views:HomeView}" />
        </Tab>
        <Tab Title="TV">
            <ShellContent ContentTemplate="{DataTemplate views:LiveTvView}" />
        </Tab>
        <Tab Title="Films">
            <ShellContent ContentTemplate="{DataTemplate views:FilmsView}" />
        </Tab>
        <Tab Title="Series">
            <ShellContent ContentTemplate="{DataTemplate views:SeriesView}" />
        </Tab>
        <Tab Title="Sources">
            <ShellContent ContentTemplate="{DataTemplate views:SourcesView}" />
        </Tab>
        <Tab Title="Reglages">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" />
        </Tab>
    </TabBar>

</Shell>
