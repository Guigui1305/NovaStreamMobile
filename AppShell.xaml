<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="NovaStreamMobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NovaStreamMobile.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="#141414"
       Shell.TabBarForegroundColor="#E50914"
       Shell.TabBarUnselectedColor="#808080"
       Shell.TabBarTitleColor="#E50914"
       BackgroundColor="#0A0A0A"
       ForegroundColor="White">

    <TabBar>
        <Tab Title="Accueil">
            <ShellContent ContentTemplate="{DataTemplate views:HomeView}" />
        </Tab>
        <Tab Title="TV Direct">
            <ShellContent ContentTemplate="{DataTemplate views:LiveTvView}" />
        </Tab>
        <Tab Title="Sources">
            <ShellContent ContentTemplate="{DataTemplate views:SourcesView}" />
        </Tab>
        <Tab Title="Reglages">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" />
        </Tab>
    </TabBar>

</Shell>
