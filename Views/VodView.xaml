<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaStreamMobile.Views.VodView"
             BackgroundColor="#0A0A0A"
             Title="Films / Series">

    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="0">

        <!-- Tabs Films / Series -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" BackgroundColor="#141414" Padding="0" HeightRequest="48">
            <Button x:Name="FilmsTab" Text="Films" Clicked="OnFilmsTabClicked"
                    BackgroundColor="Transparent" TextColor="#E50914" FontAttributes="Bold" FontSize="16"
                    CornerRadius="0" BorderWidth="0" />
            <Button x:Name="SeriesTab" Grid.Column="1" Text="Series" Clicked="OnSeriesTabClicked"
                    BackgroundColor="Transparent" TextColor="#808080" FontSize="16"
                    CornerRadius="0" BorderWidth="0" />
        </Grid>

        <!-- Barre de recherche + filtre categorie -->
        <Grid Grid.Row="1" Padding="12,8" RowDefinitions="Auto, Auto" RowSpacing="8" BackgroundColor="#141414">
            <Frame Grid.Row="0" Padding="10,0" HeightRequest="40" CornerRadius="20"
                   BackgroundColor="#1F1F1F" BorderColor="#333333" HasShadow="False">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="Rechercher" VerticalOptions="Center" Margin="0,0,8,0" TextColor="#808080" FontSize="12" />
                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher..."
                           TextColor="White" PlaceholderColor="#808080" FontSize="14"
                           VerticalOptions="Center" BackgroundColor="Transparent"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </Frame>
            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="CategoriesBar" Spacing="8" />
            </ScrollView>
        </Grid>

        <!-- Grille de contenu -->
        <CollectionView x:Name="ContentCollection" Grid.Row="2" Margin="8,4">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60">
                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="#E50914" />
                    <Label x:Name="EmptyLabel" Text="Chargement..." FontSize="16" TextColor="#808080"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="10" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <Frame CornerRadius="8" Padding="0" HeightRequest="170"
                               BackgroundColor="#1F1F1F" BorderColor="#333333" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Frame.GestureRecognizers>
                            <Grid>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                <Frame BackgroundColor="#CC000000" CornerRadius="4" Padding="4,2"
                                       HorizontalOptions="End" VerticalOptions="End" Margin="4"
                                       BorderColor="Transparent" HasShadow="False"
                                       IsVisible="{Binding HasRating}">
                                    <Label Text="{Binding Rating}" FontSize="10" TextColor="#FFD700" FontAttributes="Bold" />
                                </Frame>
                            </Grid>
                        </Frame>
                        <Label Text="{Binding Name}" FontSize="11" TextColor="White"
                               LineBreakMode="TailTruncation" MaxLines="2"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
