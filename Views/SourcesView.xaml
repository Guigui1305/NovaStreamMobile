<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaStreamMobile.Views.SourcesView"
             BackgroundColor="{StaticResource Background}"
             Title="Sources">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Label Text="MES SOURCES" FontSize="22" FontAttributes="Bold" TextColor="White" />
            <Label Text="Gerez vos sources IPTV (M3U ou Xtream Codes)" TextColor="{StaticResource TextSecondary}" FontSize="13" />
            
            <Button Text="+ Ajouter une source" BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="10" HeightRequest="48" FontAttributes="Bold" FontSize="14"
                    Clicked="OnAddSourceClicked" />
        </VerticalStackLayout>

        <!-- Liste des sources -->
        <CollectionView Grid.Row="1" x:Name="SourcesCollection" Margin="0,8,0,0">
            <CollectionView.EmptyView>
                <Frame Style="{StaticResource CardFrame}" Margin="0,20">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Padding="16">
                        <Label Text="Aucune source configuree" FontSize="18" FontAttributes="Bold" 
                               TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Text="Ajoutez une source M3U ou Xtream Codes pour commencer a regarder vos chaines." 
                               TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <!-- Icone type -->
                            <Frame Grid.Column="0" CornerRadius="20" WidthRequest="44" HeightRequest="44" 
                                   Padding="0" BackgroundColor="{StaticResource SurfaceLight}" 
                                   BorderColor="Transparent" HasShadow="False">
                                <Label Text="{Binding Type}" FontSize="10" FontAttributes="Bold" 
                                       TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            
                            <!-- Info source -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="White" />
                                <Label Text="{Binding Url}" FontSize="11" TextColor="{StaticResource TextMuted}" 
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DateAdded, StringFormat='Ajoutee le {0:dd/MM/yyyy}'}" 
                                       FontSize="10" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            
                            <!-- Bouton supprimer -->
                            <Button Grid.Column="2" Text="X" BackgroundColor="#40E50914" TextColor="{StaticResource Primary}" 
                                    CornerRadius="15" WidthRequest="34" HeightRequest="34" Padding="0" FontSize="12"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteSourceClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
