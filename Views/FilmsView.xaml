<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NovaStreamMobile.Views.FilmsView"
             BackgroundColor="{StaticResource Background}"
             Title="Films"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ PLAYER SECTION ============ -->
        <Grid x:Name="PlayerSection" Grid.Row="0" HeightRequest="240" 
              BackgroundColor="Black" IsVisible="False">
            
            <toolkit:MediaElement x:Name="Player"
                                  ShouldAutoPlay="True"
                                  ShouldShowPlaybackControls="False"
                                  Background="Black"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

            <BoxView Color="#80000000" VerticalOptions="End" HeightRequest="80"
                     InputTransparent="True" />

            <Grid VerticalOptions="End" Padding="12,0,12,8" 
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button x:Name="BtnPlayPause" Grid.Column="0" Text="⏸" 
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnPlayPauseClicked" />
                <Label x:Name="NowPlayingLabel" Grid.Column="1" 
                       Text="" TextColor="White" FontSize="13" 
                       FontAttributes="Bold" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="2" Text="🔊"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnVolumeClicked" />
                <Button Grid.Column="3" Text="📺"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnExternalPlayerClicked" />
                <Button Grid.Column="4" Text="✕"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnClosePlayerClicked" />
            </Grid>

            <ActivityIndicator x:Name="PlayerLoading" IsRunning="False" 
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               WidthRequest="40" HeightRequest="40" />
        </Grid>

        <!-- ============ HEADER + SEARCH + CATEGORIES ============ -->
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Films" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" x:Name="StatusLabel" 
                       Style="{StaticResource SubtitleLabel}" VerticalOptions="End" />
            </Grid>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" 
                   FontSize="12" IsVisible="False" />

            <Frame BackgroundColor="{StaticResource SurfaceLight}" 
                   CornerRadius="14" Padding="0" HasShadow="False"
                   BorderColor="{StaticResource CardBorder}">
                <Entry x:Name="SearchEntry" Placeholder="Rechercher un film..."
                       BackgroundColor="Transparent" Margin="14,0"
                       TextChanged="OnSearchTextChanged" />
            </Frame>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="CategoriesBar" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- ============ FILMS GRID ============ -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="FilmsList" Margin="16,8,16,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" 
                                         Spacing="8" Padding="20">
                        <Label Text="🎬" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Selectionnez une categorie" 
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" 
                                     HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="{StaticResource SurfaceCard}"
                               BorderColor="{StaticResource CardBorder}"
                               CornerRadius="12" Padding="0" HasShadow="False"
                               IsClippedToBounds="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFilmTapped" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="160,Auto">
                                <Image Grid.Row="0" Source="{Binding ImageUrl}" 
                                       Aspect="AspectFill" HeightRequest="160" />
                                <Frame Grid.Row="0" CornerRadius="8" Padding="6,3"
                                       BackgroundColor="#CC000000" BorderColor="Transparent"
                                       HasShadow="False" HorizontalOptions="End" 
                                       VerticalOptions="Start" Margin="6"
                                       IsVisible="{Binding HasRating}">
                                    <Label Text="{Binding Rating}" FontSize="10" 
                                           FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                </Frame>
                                <Frame Grid.Row="0" CornerRadius="8" Padding="6,3"
                                       BackgroundColor="#CCE50914" BorderColor="Transparent"
                                       HasShadow="False" HorizontalOptions="Start" 
                                       VerticalOptions="End" Margin="6"
                                       IsVisible="{Binding HasYear}">
                                    <Label Text="{Binding Year}" FontSize="9" 
                                           FontAttributes="Bold" TextColor="White" />
                                </Frame>
                                <VerticalStackLayout Grid.Row="1" Padding="8,6" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="11" 
                                           FontAttributes="Bold" TextColor="White"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Load more button -->
            <Button x:Name="LoadMoreButton" Text="Charger plus..."
                    BackgroundColor="{StaticResource SurfaceLight}" 
                    TextColor="{StaticResource Primary}" FontSize="13"
                    CornerRadius="20" HeightRequest="36" Margin="40,0,40,12"
                    VerticalOptions="End" IsVisible="False"
                    Clicked="OnLoadMoreClicked" />
        </Grid>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="2" x:Name="LoadingIndicator" 
                           IsRunning="False" Color="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="40" HeightRequest="40" />
    </Grid>
</ContentPage>
