<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaStreamMobile.Views.SeriesView"
             BackgroundColor="#0A0A0A"
             Title="Series">

    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="0">

        <!-- Zone Lecteur Video integre -->
        <Grid x:Name="PlayerSection" Grid.Row="0" HeightRequest="220" BackgroundColor="Black"
              IsVisible="False">
            <ContentView x:Name="VideoContainer" />

            <Grid>
                <Frame BackgroundColor="#CC000000" CornerRadius="8" Padding="8,4"
                       HorizontalOptions="Start" VerticalOptions="Start" Margin="10"
                       BorderColor="Transparent" HasShadow="False">
                    <Label x:Name="NowPlayingLabel" Text="" FontSize="12" FontAttributes="Bold" TextColor="White" />
                </Frame>

                <Button Text="X" FontSize="14" BackgroundColor="#80000000" TextColor="White"
                        CornerRadius="15" Padding="8,4" HeightRequest="30" WidthRequest="30"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="10"
                        Clicked="OnClosePlayerClicked" />

                <Frame BackgroundColor="#99000000" CornerRadius="0" Padding="8" VerticalOptions="End"
                       BorderColor="Transparent" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="PlayPauseBtn" Text=">"
                                FontSize="18" BackgroundColor="Transparent" TextColor="White"
                                WidthRequest="40" HeightRequest="40" Padding="0"
                                Clicked="OnPlayPauseClicked" />
                        <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                            <Label Text="Vol" VerticalOptions="Center" Margin="0,0,5,0" TextColor="White" FontSize="10" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                    MinimumTrackColor="#E50914" MaximumTrackColor="#555555" ThumbColor="White"
                                    ValueChanged="OnVolumeChanged" />
                        </Grid>
                        <Button Grid.Column="2" Text="[ ]" FontSize="12" BackgroundColor="Transparent" TextColor="White"
                                WidthRequest="36" HeightRequest="36" Padding="0" Clicked="OnFullscreenClicked" />
                        <Button Grid.Column="3" Text="Ext" FontSize="10" BackgroundColor="#80000000" TextColor="White"
                                CornerRadius="15" Padding="8,4" HeightRequest="30"
                                Clicked="OnExternalPlayerClicked" />
                    </Grid>
                </Frame>
            </Grid>

            <ActivityIndicator x:Name="PlayerLoading" IsRunning="False" Color="#E50914"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Barre de recherche + categories -->
        <VerticalStackLayout Grid.Row="1" BackgroundColor="#141414" Spacing="0">
            <Label x:Name="StatusLabel" Text="" FontSize="11" TextColor="#808080" Margin="12,4,12,0" />
            <Label x:Name="ErrorLabel" Text="" FontSize="11" TextColor="#E50914" Margin="12,2,12,0" />

            <Frame Padding="10,0" HeightRequest="38" CornerRadius="20" Margin="12,6,12,4"
                   BackgroundColor="#1F1F1F" BorderColor="#333333" HasShadow="False">
                <Entry x:Name="SearchEntry" Placeholder="Rechercher une serie..."
                       TextColor="White" PlaceholderColor="#808080" FontSize="14"
                       VerticalOptions="Center" BackgroundColor="Transparent"
                       TextChanged="OnSearchTextChanged" />
            </Frame>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,2,0,6">
                <HorizontalStackLayout x:Name="CategoriesBar" Spacing="6" Padding="12,0" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- Grille de series -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="ContentCollection" Margin="6,4">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60">
                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" Color="#E50914" />
                        <Label x:Name="EmptyLabel" Text="Selectionnez une categorie" FontSize="14" TextColor="#808080"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="3">
                            <Frame CornerRadius="8" Padding="0" HeightRequest="165"
                                   BackgroundColor="#1A1A1A" BorderColor="Transparent" HasShadow="False"
                                   IsClippedToBounds="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSeriesTapped" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    <BoxView Color="#80000000" VerticalOptions="End" HeightRequest="40" />
                                    <Frame BackgroundColor="#CC000000" CornerRadius="4" Padding="4,2"
                                           HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                           BorderColor="Transparent" HasShadow="False"
                                           IsVisible="{Binding HasRating}">
                                        <Label Text="{Binding Rating}" FontSize="10" TextColor="#FFD700" FontAttributes="Bold" />
                                    </Frame>
                                    <Frame BackgroundColor="#CCE50914" CornerRadius="4" Padding="4,2"
                                           HorizontalOptions="Start" VerticalOptions="End" Margin="4"
                                           BorderColor="Transparent" HasShadow="False"
                                           IsVisible="{Binding HasYear}">
                                        <Label Text="{Binding Year}" FontSize="9" TextColor="White" FontAttributes="Bold" />
                                    </Frame>
                                </Grid>
                            </Frame>
                            <Label Text="{Binding Name}" FontSize="10" TextColor="White"
                                   LineBreakMode="TailTruncation" MaxLines="2"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="LoadMoreButton" Text="Charger plus..."
                    BackgroundColor="#1F1F1F" TextColor="#E50914" FontSize="13"
                    CornerRadius="20" HeightRequest="36" Margin="40,0,40,12"
                    VerticalOptions="End" IsVisible="False"
                    Clicked="OnLoadMoreClicked" BorderColor="#333333" BorderWidth="1" />
        </Grid>
    </Grid>
</ContentPage>
