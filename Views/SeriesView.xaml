<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NovaStreamMobile.Views.SeriesView"
             BackgroundColor="{StaticResource Background}"
             Title="Series"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ PLAYER SECTION ============ -->
        <Grid x:Name="PlayerSection" Grid.Row="0" HeightRequest="240" 
              BackgroundColor="Black" IsVisible="False">
            
            <toolkit:MediaElement x:Name="Player"
                                  ShouldAutoPlay="True"
                                  ShouldShowPlaybackControls="False"
                                  Background="Black"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

            <BoxView Color="#80000000" VerticalOptions="End" HeightRequest="80"
                     InputTransparent="True" />

            <Grid VerticalOptions="End" Padding="12,0,12,8" 
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button x:Name="BtnPlayPause" Grid.Column="0" Text="⏸" 
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnPlayPauseClicked" />
                <Label x:Name="NowPlayingLabel" Grid.Column="1" 
                       Text="" TextColor="White" FontSize="13" 
                       FontAttributes="Bold" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="2" Text="🔊"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnVolumeClicked" />
                <Button Grid.Column="3" Text="📺"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnExternalPlayerClicked" />
                <Button Grid.Column="4" Text="✕"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnClosePlayerClicked" />
            </Grid>

            <ActivityIndicator x:Name="PlayerLoading" IsRunning="False" 
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               WidthRequest="40" HeightRequest="40" />
        </Grid>

        <!-- ============ HEADER + SEARCH + CATEGORIES ============ -->
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Series" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" x:Name="StatusLabel" 
                       Style="{StaticResource SubtitleLabel}" VerticalOptions="End" />
            </Grid>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" 
                   FontSize="12" IsVisible="False" />

            <!-- Navigation breadcrumb -->
            <HorizontalStackLayout x:Name="BreadcrumbBar" Spacing="4" IsVisible="False">
                <Button x:Name="BtnBackToSeries" Text="← Series" 
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        FontSize="13" FontAttributes="Bold" Padding="0"
                        Clicked="OnBackToSeriesClicked" />
                <Label x:Name="BreadcrumbLabel" Text="" TextColor="{StaticResource TextMuted}" 
                       FontSize="13" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Frame BackgroundColor="{StaticResource SurfaceLight}" 
                   CornerRadius="14" Padding="0" HasShadow="False"
                   BorderColor="{StaticResource CardBorder}">
                <Entry x:Name="SearchEntry" Placeholder="Rechercher une serie..."
                       BackgroundColor="Transparent" Margin="14,0"
                       TextChanged="OnSearchTextChanged" />
            </Frame>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="CategoriesBar" Spacing="8" />
            </ScrollView>

            <!-- Seasons bar -->
            <ScrollView x:Name="SeasonsScrollView" Orientation="Horizontal" 
                        HorizontalScrollBarVisibility="Never" IsVisible="False">
                <HorizontalStackLayout x:Name="SeasonsBar" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- ============ CONTENT AREA ============ -->
        <Grid Grid.Row="2">
            <!-- Series Grid -->
            <CollectionView x:Name="SeriesList" Margin="16,8,16,0" IsVisible="True">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" 
                                         Spacing="8" Padding="20">
                        <Label Text="📺" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Selectionnez une categorie" 
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" 
                                     HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="{StaticResource SurfaceCard}"
                               BorderColor="{StaticResource CardBorder}"
                               CornerRadius="12" Padding="0" HasShadow="False"
                               IsClippedToBounds="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSeriesTapped" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="160,Auto">
                                <Image Grid.Row="0" Source="{Binding Cover}" 
                                       Aspect="AspectFill" HeightRequest="160" />
                                <Frame Grid.Row="0" CornerRadius="8" Padding="6,3"
                                       BackgroundColor="#CC000000" BorderColor="Transparent"
                                       HasShadow="False" HorizontalOptions="End" 
                                       VerticalOptions="Start" Margin="6">
                                    <Label Text="{Binding Rating}" FontSize="10" 
                                           FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                </Frame>
                                <VerticalStackLayout Grid.Row="1" Padding="8,6" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="11" 
                                           FontAttributes="Bold" TextColor="White"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Episodes List -->
            <CollectionView x:Name="EpisodesList" Margin="16,8,16,0" IsVisible="False">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" 
                                         Spacing="8" Padding="20">
                        <Label Text="Aucun episode" Style="{StaticResource SubtitleLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="{StaticResource SurfaceCard}"
                               BorderColor="{StaticResource CardBorder}"
                               CornerRadius="12" Padding="12" HasShadow="False"
                               Margin="0,0,0,6">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEpisodeTapped" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Frame Grid.Column="0" CornerRadius="8" Padding="0" 
                                       HasShadow="False" IsClippedToBounds="True"
                                       WidthRequest="80" HeightRequest="50"
                                       BackgroundColor="{StaticResource SurfaceLight}">
                                    <Image Source="{Binding Info.MovieImage}" 
                                           Aspect="AspectFill" />
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" 
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="13" 
                                           FontAttributes="Bold" TextColor="White"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Info.Plot}" FontSize="10" 
                                           TextColor="{StaticResource TextMuted}"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="▶" FontSize="20" 
                                       TextColor="{StaticResource Primary}" 
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Load more button -->
            <Button x:Name="LoadMoreButton" Text="Charger plus..."
                    BackgroundColor="{StaticResource SurfaceLight}" 
                    TextColor="{StaticResource Primary}" FontSize="13"
                    CornerRadius="20" HeightRequest="36" Margin="40,0,40,12"
                    VerticalOptions="End" IsVisible="False"
                    Clicked="OnLoadMoreClicked" />
        </Grid>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="2" x:Name="LoadingIndicator" 
                           IsRunning="False" Color="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="40" HeightRequest="40" />
    </Grid>
</ContentPage>
