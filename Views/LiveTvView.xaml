<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NovaStreamMobile.ViewModels"
             xmlns:models="clr-namespace:NovaStreamMobile.Models"
             x:Class="NovaStreamMobile.Views.LiveTvView"
             BackgroundColor="{StaticResource Background}"
             Title="TV Direct">
    
    <ContentPage.BindingContext>
        <vm:LiveTvViewModel />
    </ContentPage.BindingContext>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PlayerRow" Height="250" />
            <RowDefinition x:Name="SearchRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Zone Lecteur Video -->
        <Grid Grid.Row="0" BackgroundColor="Black">
            <ContentView x:Name="VideoContainer" />
            
            <!-- Indicateur de luminosite -->
            <Frame x:Name="BrightnessIndicator" 
                   IsVisible="False"
                   BackgroundColor="#CC000000" 
                   CornerRadius="10" 
                   Padding="10" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   BorderColor="Transparent"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5" WidthRequest="40">
                    <Label Text="*" HorizontalOptions="Center" FontSize="20" TextColor="Yellow" />
                    <ProgressBar x:Name="BrightnessBar" Progress="0.5" ProgressColor="{StaticResource Primary}" 
                                 HeightRequest="100" Rotation="-90" WidthRequest="100" />
                </VerticalStackLayout>
            </Frame>
            
            <!-- Controles du lecteur -->
            <Grid IsVisible="{Binding HasChannel}">
                <!-- Barre superieure : Sous-titres, PiP -->
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="10" Spacing="8">
                    <Button Text="PiP" FontSize="10" BackgroundColor="#80000000" TextColor="White" 
                            CornerRadius="15" Padding="8,4" HeightRequest="30" Clicked="OnPipClicked" />
                    <Button x:Name="SubtitleButton" Text="CC" FontSize="10" BackgroundColor="#80000000" TextColor="White" 
                            CornerRadius="15" Padding="8,4" HeightRequest="30" Clicked="OnSubtitleClicked" />
                </HorizontalStackLayout>

                <!-- Barre inferieure : Controles -->
                <Frame BackgroundColor="#99000000" CornerRadius="0" Padding="10" VerticalOptions="End" 
                       BorderColor="Transparent" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="&lt;&lt;" Command="{Binding PreviousChannelCommand}" 
                                FontSize="14" BackgroundColor="Transparent" TextColor="White" 
                                WidthRequest="40" HeightRequest="40" Padding="0" />

                        <Button Grid.Column="1" x:Name="PlayPauseBtn" Text=">" 
                                Command="{Binding PlayPauseCommand}" 
                                FontSize="18" BackgroundColor="Transparent" TextColor="White"
                                WidthRequest="44" HeightRequest="44" Padding="0" />

                        <Button Grid.Column="2" Text=">>" Command="{Binding NextChannelCommand}" 
                                FontSize="14" BackgroundColor="Transparent" TextColor="White" 
                                WidthRequest="40" HeightRequest="40" Padding="0" />

                        <Grid Grid.Column="3" ColumnDefinitions="Auto, *">
                            <Label Text="Vol" VerticalOptions="Center" Margin="0,0,5,0" TextColor="White" FontSize="10" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" 
                                    MinimumTrackColor="{StaticResource Primary}" MaximumTrackColor="#555555" ThumbColor="White" />
                        </Grid>

                        <Button Grid.Column="4" Text="[ ]" FontSize="12" BackgroundColor="Transparent" TextColor="White"
                                WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnFullscreenClicked" />
                    </Grid>
                </Frame>

                <!-- Info chaine en cours -->
                <Frame BackgroundColor="#CC000000" CornerRadius="8" Padding="8,4" 
                       HorizontalOptions="Start" VerticalOptions="Start" Margin="10"
                       BorderColor="Transparent" HasShadow="False">
                    <Label Text="{Binding CurrentChannelName}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                </Frame>
            </Grid>

            <!-- Ecran d'attente -->
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                                 IsVisible="{Binding HasChannel, Converter={StaticResource BoolInvertConverter}}">
                <Label Text="PAS DE SIGNAL" FontSize="22" FontAttributes="Bold" TextColor="#333333" HorizontalTextAlignment="Center" />
                <Label Text="Selectionnez une chaine pour commencer" TextColor="{StaticResource TextMuted}" 
                       HorizontalTextAlignment="Center" FontSize="13" />
            </VerticalStackLayout>
            
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" 
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Barre de recherche et filtre -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource Secondary}" Padding="10,8" RowDefinitions="Auto, Auto" RowSpacing="8">
            <Frame Grid.Row="0" Padding="10,0" HeightRequest="40" CornerRadius="20" 
                   BackgroundColor="{StaticResource SurfaceLight}" BorderColor="{StaticResource CardBorder}" HasShadow="False">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="Rechercher" VerticalOptions="Center" Margin="0,0,8,0" TextColor="{StaticResource TextMuted}" FontSize="12" />
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Rechercher des chaines..." 
                           TextColor="White" PlaceholderColor="{StaticResource TextMuted}" FontSize="14" 
                           VerticalOptions="Center" BackgroundColor="Transparent" />
                </Grid>
            </Frame>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Categorie :" VerticalOptions="Center" TextColor="{StaticResource TextMuted}" FontSize="12" />
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                            TextColor="{StaticResource Primary}" FontSize="14" BackgroundColor="Transparent"
                            Title="Toutes" WidthRequest="160" />
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Zone de contenu : Sources + Chaines -->
        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnDefinitions="80, *">
            <!-- Liste des sources (sidebar) -->
            <CollectionView Grid.Column="0" ItemsSource="{Binding Sources}" 
                            SelectedItem="{Binding SelectedSource}"
                            SelectionMode="Single"
                            BackgroundColor="{StaticResource Secondary}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#30E50914" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Frame CornerRadius="20" WidthRequest="42" HeightRequest="42" Padding="0" 
                                       BackgroundColor="{StaticResource SurfaceLight}" BorderColor="{StaticResource CardBorder}"
                                       HasShadow="False">
                                    <Label Text="{Binding Name, StringFormat='{0:0}'}" HorizontalOptions="Center" VerticalOptions="Center" 
                                           FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="10" />
                                </Frame>
                                <Label Text="{Binding Name}" FontSize="8" HorizontalTextAlignment="Center" 
                                       LineBreakMode="TailTruncation" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Liste des chaines -->
            <CollectionView Grid.Column="1" ItemsSource="{Binding FilteredChannels}"
                            SelectionMode="Single"
                            SelectionChanged="OnChannelSelected"
                            Margin="8,4">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,40">
                        <Label Text="Aucune chaine" FontSize="18" TextColor="{StaticResource TextSecondary}" 
                               HorizontalTextAlignment="Center" FontAttributes="Bold" />
                        <Label Text="Selectionnez une source ou ajoutez-en une dans l'onglet Sources" 
                               FontSize="13" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Channel">
                        <Frame Style="{StaticResource CardFrame}" Padding="10">
                            <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="10">
                                <!-- Logo chaine -->
                                <Frame Grid.Column="0" CornerRadius="8" Padding="0" HeightRequest="48" WidthRequest="48" 
                                       BackgroundColor="{StaticResource SurfaceLight}" BorderColor="Transparent" HasShadow="False">
                                    <Image Source="{Binding LogoUrl}" Aspect="AspectFit" Margin="4" />
                                </Frame>

                                <!-- Info chaine + EPG -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" 
                                           LineBreakMode="TailTruncation" TextColor="White" />
                                    <Label Text="{Binding CurrentProgramTitle}" FontSize="11" 
                                           TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
                                    <ProgressBar Progress="{Binding CurrentProgramProgress}" 
                                                 ProgressColor="{StaticResource Accent}" HeightRequest="2" Margin="0,2,0,0"
                                                 IsVisible="{Binding HasCurrentProgram}" />
                                    <Label Text="{Binding Group}" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <!-- Bouton favori -->
                                <Button Grid.Column="2" Text="*" FontSize="20"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveTvViewModel}}, Path=ToggleFavoriteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" VerticalOptions="Center"
                                        WidthRequest="40" HeightRequest="40" Padding="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="TextColor" Value="#444444" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource FavoriteGold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
