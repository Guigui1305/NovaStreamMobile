<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="NovaStreamMobile.Views.LiveTvView"
             BackgroundColor="{StaticResource Background}"
             Title="TV Direct"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ PLAYER SECTION ============ -->
        <Grid x:Name="PlayerSection" Grid.Row="0" HeightRequest="240" 
              BackgroundColor="Black" IsVisible="False">
            
            <toolkit:MediaElement x:Name="Player"
                                  ShouldAutoPlay="True"
                                  ShouldShowPlaybackControls="False"
                                  Background="Black"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

            <!-- Gradient overlay bottom -->
            <BoxView Color="#80000000" VerticalOptions="End" HeightRequest="80"
                     InputTransparent="True" />

            <!-- Controls overlay -->
            <Grid VerticalOptions="End" Padding="12,0,12,8" 
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button x:Name="BtnPlayPause" Grid.Column="0" Text="⏸" 
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnPlayPauseClicked" />
                <Label x:Name="NowPlayingLabel" Grid.Column="1" 
                       Text="" TextColor="White" FontSize="13" 
                       FontAttributes="Bold" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="2" Text="🔊"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnVolumeClicked" />
                <Button Grid.Column="3" Text="📺"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnExternalPlayerClicked" />
                <Button Grid.Column="4" Text="✕"
                        Style="{StaticResource PlayerControlButton}"
                        Clicked="OnClosePlayerClicked" />
            </Grid>

            <!-- Loading -->
            <ActivityIndicator x:Name="PlayerLoading" IsRunning="False" 
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               WidthRequest="40" HeightRequest="40" />
        </Grid>

        <!-- ============ HEADER + SEARCH + CATEGORIES ============ -->
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="TV Direct" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" x:Name="StatusLabel" 
                       Style="{StaticResource SubtitleLabel}" VerticalOptions="End" />
            </Grid>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" 
                   FontSize="12" IsVisible="False" />

            <Frame BackgroundColor="{StaticResource SurfaceLight}" 
                   CornerRadius="14" Padding="0" HasShadow="False"
                   BorderColor="{StaticResource CardBorder}">
                <Entry x:Name="SearchEntry" Placeholder="Rechercher une chaine..."
                       BackgroundColor="Transparent" Margin="14,0"
                       TextChanged="OnSearchTextChanged" />
            </Frame>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="CategoriesBar" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- ============ CHANNELS LIST ============ -->
        <CollectionView Grid.Row="2" x:Name="ChannelsList" Margin="16,8,16,0"
                        SelectionMode="Single" SelectionChanged="OnChannelSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" 
                                     Spacing="8" Padding="20">
                    <Label Text="📡" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Selectionnez une categorie" 
                           Style="{StaticResource SubtitleLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource SurfaceCard}"
                           BorderColor="{StaticResource CardBorder}"
                           CornerRadius="14" Padding="12" HasShadow="False">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
                            <Frame Grid.Column="0" CornerRadius="12" Padding="0"
                                   WidthRequest="52" HeightRequest="52"
                                   BackgroundColor="{StaticResource SurfaceLight}"
                                   BorderColor="Transparent" HasShadow="False"
                                   IsClippedToBounds="True">
                                <Image Source="{Binding LogoUrl}" Aspect="AspectFill"
                                       WidthRequest="52" HeightRequest="52" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" FontSize="14" 
                                       FontAttributes="Bold" TextColor="White"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CurrentProgramTitle}" 
                                       FontSize="11" TextColor="{StaticResource TextMuted}"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding HasCurrentProgram}" />
                            </VerticalStackLayout>
                            <Frame Grid.Column="2" CornerRadius="10" Padding="8,4"
                                   BackgroundColor="#30E50914" BorderColor="Transparent"
                                   HasShadow="False" VerticalOptions="Center">
                                <Label Text="EN DIRECT" FontSize="9" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Frame>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="2" x:Name="LoadingIndicator" 
                           IsRunning="False" Color="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="40" HeightRequest="40" />
    </Grid>
</ContentPage>
