<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NovaStreamMobile.ViewModels"
             x:Class="NovaStreamMobile.Views.HomeView"
             BackgroundColor="{StaticResource Background}"
             Title="Accueil">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">
            
            <!-- Header Netflix style -->
            <Grid Padding="0,16,0,0">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="NOVASTREAM" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" 
                           HorizontalTextAlignment="Center" CharacterSpacing="3" />
                    <Label Text="Votre hub IPTV personnel" TextColor="{StaticResource TextSecondary}" 
                           HorizontalTextAlignment="Center" FontSize="14" />
                </VerticalStackLayout>
            </Grid>

            <!-- Carte de bienvenue -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="Bienvenue !" FontAttributes="Bold" FontSize="20" TextColor="White" />
                        <Label Text="Pret a regarder vos chaines preferees ? Rendez-vous dans l'onglet TV Direct pour commencer." 
                               TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="1" BackgroundColor="{StaticResource Primary}" CornerRadius="30"
                           WidthRequest="60" HeightRequest="60" Padding="0" BorderColor="Transparent" HasShadow="False">
                        <Label Text="TV" FontSize="20" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- Statistiques rapides -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding SourceCount}" FontSize="28" FontAttributes="Bold" 
                               TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="Sources" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding FavoriteCount}" FontSize="28" FontAttributes="Bold" 
                               TextColor="{StaticResource FavoriteGold}" HorizontalTextAlignment="Center" />
                        <Label Text="Favoris" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Historique recent -->
            <VerticalStackLayout Spacing="12">
                <Label Text="REGARDES RECEMMENT" Style="{StaticResource TitleLabel}" />
                
                <CollectionView ItemsSource="{Binding RecentChannels}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <Label Text="Aucune chaine regardee recemment. Allez dans TV Direct pour commencer !" 
                                   HorizontalTextAlignment="Center" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="10" 
                                   Padding="12" BorderColor="{StaticResource CardBorder}" HasShadow="False"
                                   WidthRequest="160">
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Frame BackgroundColor="{StaticResource SurfaceLight}" CornerRadius="8"
                                           WidthRequest="50" HeightRequest="50" Padding="0" 
                                           BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                        <Label Text="TV" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding .}" FontSize="11" HorizontalTextAlignment="Center"
                                           TextColor="White" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Actions rapides -->
            <VerticalStackLayout Spacing="12">
                <Label Text="ACTIONS RAPIDES" Style="{StaticResource TitleLabel}" />
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource Accent}" CornerRadius="25"
                                   WidthRequest="50" HeightRequest="50" Padding="0" 
                                   BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                <Label Text="+" FontSize="24" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="Ajouter une source" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToSources" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource AccentBlue}" CornerRadius="25"
                                   WidthRequest="50" HeightRequest="50" Padding="0" 
                                   BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                <Label Text=">" FontSize="24" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="TV en direct" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToLiveTv" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </Grid>
            </VerticalStackLayout>

            <!-- Info app -->
            <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="NovaStream v2.0" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="Lecteur IPTV premium pour Android. EPG, sous-titres, favoris, reprise de lecture et bien plus." 
                           TextColor="{StaticResource TextMuted}" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
