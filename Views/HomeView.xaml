<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NovaStreamMobile.ViewModels"
             xmlns:models="clr-namespace:NovaStreamMobile.Models"
             xmlns:services="clr-namespace:NovaStreamMobile.Services"
             x:Class="NovaStreamMobile.Views.HomeView"
             BackgroundColor="{StaticResource Background}"
             Title="Accueil">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="0,0,0,20">
            
            <!-- Header premium -->
            <Grid BackgroundColor="#141414" Padding="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
                    <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="22" 
                           WidthRequest="44" HeightRequest="44" Padding="0" 
                           BorderColor="Transparent" HasShadow="False">
                        <Label Text="N" FontSize="22" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="NOVASTREAM" FontSize="20" FontAttributes="Bold" TextColor="White" 
                               CharacterSpacing="2" />
                        <Label Text="{Binding WelcomeMessage}" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Stats rapides -->
                <HorizontalStackLayout Grid.Row="1" Spacing="20" Margin="0,14,0,0">
                    <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="10" Padding="12,8"
                           BorderColor="{StaticResource CardBorder}" HasShadow="False">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding SourceCount}" FontSize="18" FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Text="Sources" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                    <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="10" Padding="12,8"
                           BorderColor="{StaticResource CardBorder}" HasShadow="False">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding FavoriteCount}" FontSize="18" FontAttributes="Bold" 
                                   TextColor="{StaticResource FavoriteGold}" VerticalOptions="Center" />
                            <Label Text="Favoris" FontSize="12" TextColor="{StaticResource TextSecondary}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </HorizontalStackLayout>
            </Grid>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" 
                               Margin="0,10" />

            <!-- Chaines populaires -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasPopularChannels}">
                <Label Text="CHAINES POPULAIRES" Style="{StaticResource TitleLabel}" Margin="16,0" />
                <CollectionView ItemsSource="{Binding PopularChannels}" HeightRequest="90">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView WidthRequest="16" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Channel">
                            <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="10" 
                                   Padding="0" BorderColor="{StaticResource CardBorder}" HasShadow="False"
                                   WidthRequest="130" HeightRequest="80" IsClippedToBounds="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChannelTapped" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Image Source="{Binding LogoUrl}" Aspect="AspectFit" 
                                           Margin="8" Opacity="0.8" />
                                    <BoxView Color="#80000000" VerticalOptions="End" HeightRequest="28" />
                                    <Label Text="{Binding Name}" FontSize="9" TextColor="White"
                                           VerticalOptions="End" Margin="6,0,6,4"
                                           LineBreakMode="TailTruncation" FontAttributes="Bold" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Films tendance -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasTrendingMovies}">
                <Label Text="FILMS TENDANCE" Style="{StaticResource TitleLabel}" Margin="16,0" />
                <CollectionView ItemsSource="{Binding TrendingMovies}" HeightRequest="200">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView WidthRequest="16" Color="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:VodItem">
                            <VerticalStackLayout Spacing="4" WidthRequest="120">
                                <Frame CornerRadius="8" Padding="0" HeightRequest="170"
                                       BackgroundColor="{StaticResource Surface}" BorderColor="Transparent" 
                                       HasShadow="False" IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMovieTapped" />
                                    </Frame.GestureRecognizers>
                                    <Image Source="{Binding StreamIcon}" Aspect="AspectFill" />
                                </Frame>
                                <Label Text="{Binding Name}" FontSize="10" TextColor="White"
                                       LineBreakMode="TailTruncation" MaxLines="2"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Historique recent -->
            <VerticalStackLayout Spacing="10" Padding="16,0">
                <Label Text="REGARDES RECEMMENT" Style="{StaticResource TitleLabel}" />
                
                <CollectionView ItemsSource="{Binding RecentChannels}" HeightRequest="100">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <Label Text="Aucune chaine regardee recemment. Allez dans TV Direct pour commencer !" 
                                   HorizontalTextAlignment="Center" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="10" 
                                   Padding="10" BorderColor="{StaticResource CardBorder}" HasShadow="False"
                                   WidthRequest="140">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Frame BackgroundColor="{StaticResource SurfaceLight}" CornerRadius="8"
                                           WidthRequest="36" HeightRequest="36" Padding="0" 
                                           BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                        <Label Text=">" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding .}" FontSize="10" HorizontalTextAlignment="Center"
                                           TextColor="White" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Actions rapides -->
            <VerticalStackLayout Spacing="10" Padding="16,0">
                <Label Text="ACCES RAPIDE" Style="{StaticResource TitleLabel}" />
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    <Frame Grid.Column="0" Style="{StaticResource CardFrame}" Padding="10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="20"
                                   WidthRequest="40" HeightRequest="40" Padding="0" 
                                   BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                <Label Text=">" FontSize="18" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="TV Direct" FontSize="11" TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToLiveTv" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource CardFrame}" Padding="10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource AccentBlue}" CornerRadius="20"
                                   WidthRequest="40" HeightRequest="40" Padding="0" 
                                   BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                <Label Text="F" FontSize="18" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="Films" FontSize="11" TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToVod" />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Frame Grid.Column="2" Style="{StaticResource CardFrame}" Padding="10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource Accent}" CornerRadius="20"
                                   WidthRequest="40" HeightRequest="40" Padding="0" 
                                   BorderColor="Transparent" HasShadow="False" HorizontalOptions="Center">
                                <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Text="Sources" FontSize="11" TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToSources" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </Grid>
            </VerticalStackLayout>

            <!-- Info app -->
            <Frame Style="{StaticResource CardFrame}" Margin="16,0,16,10">
                <HorizontalStackLayout Spacing="10">
                    <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="6" 
                           Padding="6,3" BorderColor="Transparent" HasShadow="False">
                        <Label Text="v3.0" FontSize="10" TextColor="White" FontAttributes="Bold" />
                    </Frame>
                    <Label Text="NovaStream - Lecteur IPTV Premium" FontSize="12" 
                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
