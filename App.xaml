<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:NovaStreamMobile.Converters"
             x:Class="NovaStreamMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <c:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <c:ProgressConverter x:Key="ProgressConverter" />

            <!-- Colors -->
            <Color x:Key="Primary">#2196F3</Color>
            <Color x:Key="Secondary">#121212</Color>
            <Color x:Key="Surface">#1E1E1E</Color>
            <Color x:Key="Background">#0F0F0F</Color>
            <Color x:Key="Accent">#4EC9B0</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#AAAAAA</Color>
            <Color x:Key="FavoriteGold">#FFD700</Color>

            <!-- Styles -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,10" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="Gray" />
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
