<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:NovaStreamMobile.Converters"
             x:Class="NovaStreamMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <c:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <c:ProgressConverter x:Key="ProgressConverter" />
            <c:BoolInvertConverter x:Key="BoolInvertConverter" />

            <!-- Netflix-inspired Color Palette -->
            <Color x:Key="Primary">#E50914</Color>
            <Color x:Key="PrimaryDark">#B20710</Color>
            <Color x:Key="Secondary">#141414</Color>
            <Color x:Key="Surface">#1F1F1F</Color>
            <Color x:Key="SurfaceLight">#2A2A2A</Color>
            <Color x:Key="Background">#0A0A0A</Color>
            <Color x:Key="Accent">#46D369</Color>
            <Color x:Key="AccentBlue">#2196F3</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#B3B3B3</Color>
            <Color x:Key="TextMuted">#808080</Color>
            <Color x:Key="FavoriteGold">#FFD700</Color>
            <Color x:Key="Danger">#E50914</Color>
            <Color x:Key="CardBorder">#333333</Color>

            <!-- Global Styles -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="Margin" Value="0,8" />
            </Style>

            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="BorderColor" Value="{StaticResource CardBorder}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
